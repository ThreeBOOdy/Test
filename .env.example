DATABASE_URL="mysql://practice:replace-with-url-encoded-password@127.0.0.1:3306/practice_dev"
SHADOW_DATABASE_URL="mysql://practice:replace-with-url-encoded-password@127.0.0.1:3306/practice_shadow"
APP_SEED_PASSWORD="123456"
AUTH_SECRET="replace-with-at-least-32-random-bytes"
COOKIE_SECURE="false"
APP_TIME_ZONE="Asia/Taipei"
STUDENT_DATA_ENCRYPTION_KEY="replace-with-32-random-bytes-in-base64"
STUDENT_DATA_ENCRYPTION_KEY_ID="2026-07-primary"
STUDENT_DATA_DECRYPTION_KEYS='{"previous-key-id":"replace-with-previous-32-byte-key-in-base64"}'
STUDENT_DATA_HASH_KEY="replace-with-a-different-32-random-bytes-in-base64"
MYSQL_PASSWORD="replace-with-a-long-random-database-password"
MYSQL_ROOT_PASSWORD="replace-with-a-separate-root-password"
APP_BIND_IP="192.168.50.10"
APP_ALLOWED_CIDRS="192.168.50.0/24"
# AI 模型网关（服务器出网调用 OpenAI 兼容 API；AI_PROVIDER=mock 用于本地测试）
AI_PROVIDER="cloud"
AI_BASE_URL="https://api.deepseek.com/v1"
AI_API_KEY="replace-with-your-api-key"
AI_MODEL="deepseek-chat"
AI_TIMEOUT_MS="30000"
AI_MAX_RETRIES="2"
# AI 解析批量生成 Worker 调参（可选）
AI_EXPLAIN_BATCH_SIZE="10"
AI_EXPLAIN_MAX_ROUNDS="1000"
AI_EXPLAIN_RETRIES="2"
AI_EXPLAIN_DELAY_MS="200"
# AI 答疑教练：每名学生每天最大调用次数（可选）
AI_TUTOR_DAILY_LIMIT="50"
