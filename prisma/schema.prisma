generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum StudentAccountStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum StudentRegistrationSource {
  SELF_REGISTRATION
  EXCEL_IMPORT
  LEGACY
}

enum StudentGender {
  MALE
  FEMALE
}

enum RadioPersonResourceStatus {
  AVAILABLE
  UNAVAILABLE
}

enum StudentReviewAction {
  SUBMITTED
  PROFILE_UPDATED
  RESUBMITTED
  APPROVED
  REJECTED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

enum QuestionStatus {
  ACTIVE
  DISABLED
  ARCHIVED
}

enum PracticeMode {
  LEVEL_COMPREHENSIVE
  KNOWLEDGE_POINT
  WRONG_QUESTION
  QUESTION_ORDER
  RANDOM_ALL
  MOCK_EXAM
}

enum PracticeStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum FocusSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum QuestType {
  PRACTICE
  REVIEW
  WRONG_CLEAR
  FOCUS
}

enum QuestStatus {
  IN_PROGRESS
  COMPLETED
}

enum ReviewPlanType {
  DAILY
  EXAM_SPRINT
}

enum ReviewPlanStatus {
  ACTIVE
  COMPLETED
}

enum ReviewCardSource {
  WRONG_QUESTION
  WEAK_KNOWLEDGE
}

enum ReviewCardStatus {
  PENDING
  COMPLETED
}

enum ExamSettlementSource {
  STUDENT_SUBMISSION
  AUTO_SETTLEMENT
}

enum ImportStatus {
  PREVIEW
  COMMITTED
  REVERTED
  FAILED
}

enum StudentImportStatus {
  PREVIEW
  COMMITTED
  FAILED
  EXPIRED
}

enum LearningState {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

enum AnswerResult {
  CORRECT
  INCORRECT
}

model User {
  id                         String                     @id @default(cuid())
  username                   String                     @unique
  displayName                String
  passwordHash               String
  role                       UserRole                   @default(STUDENT)
  enabled                    Boolean                    @default(true)
  mustChangePassword         Boolean                    @default(true)
  sessionVersion             Int                        @default(0)
  studentStatus              StudentAccountStatus?
  registrationSource         StudentRegistrationSource?
  nationalIdEncrypted        String?                    @db.Text
  nationalIdHash             String?                    @unique
  nationalIdLast4            String?                    @db.VarChar(4)
  gender                     StudentGender?
  school                     String?
  gradeId                    String?
  grade                      Grade?                     @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  activeLevelId              String?
  activeLevel                Level?                     @relation("StudentActiveLevel", fields: [activeLevelId], references: [id], onDelete: Restrict)
  phoneEncrypted             String?                    @db.Text
  phoneHash                  String?                    @unique
  phoneLast4                 String?                    @db.VarChar(4)
  submittedAt                DateTime?
  reviewedAt                 DateTime?
  reviewedById               String?
  reviewedBy                 User?                      @relation("StudentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedStudents           User[]                     @relation("StudentReviewedBy")
  rejectionReason            String?                    @db.Text
  validFrom                  DateTime?                  @db.Date
  validUntil                 DateTime?                  @db.Date
  isLongTerm                 Boolean                    @default(false)
  profileIncomplete          Boolean                    @default(false)
  activationRequired         Boolean                    @default(false)
  realName                   String?
  radioPersonId              String?                    @unique
  radioPerson                RadioPerson?               @relation(fields: [radioPersonId], references: [id], onDelete: Restrict)
  studentActivation          StudentActivation?
  authSessions               AuthSession[]
  sessions                   PracticeSession[]
  focusSessions              FocusSession[]
  wrongQuestions             WrongQuestion[]
  reviewPlans                ReviewPlan[]
  imports                    ImportBatch[]
  studentImports             StudentImportBatch[]
  auditLogs                  AuditLog[]
  questionRevisions          QuestionRevision[]
  studentReviewRecords       StudentReviewRecord[]      @relation("StudentReviewStudent")
  authoredReviewRecords      StudentReviewRecord[]      @relation("StudentReviewActor")
  questionExplanationReviews Question[]                 @relation("QuestionExplanationReviewedBy")
  aiUsageLogs                AiUsageLog[]
  aiConversations            AiConversation[]
  playerProfile              PlayerProfile?
  questLogs                  QuestLog[]
  xpLogs                     XpLog[]
  studentLevelQuestionStates StudentLevelQuestionState[]
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt

  @@index([role, studentStatus, enabled])
  @@index([gradeId, studentStatus])
  @@index([activeLevelId])
  @@index([reviewedById, reviewedAt])
}

model StudentActivation {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  version            Int       @default(1)
  activationCodeHash String    @db.Text
  expiresAt          DateTime
  usedAt             DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([expiresAt, usedAt])
}

model RadioPerson {
  id             String                    @id
  username       String                    @unique
  name           String
  profile        String                    @db.Text
  resourceStatus RadioPersonResourceStatus @default(AVAILABLE)
  statusNote     String?                   @db.VarChar(500)
  student        User?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([resourceStatus, name])
}

model AuthSession {
  id                String    @id @default(cuid())
  tokenHash         String    @unique
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())
  lastSeenAt        DateTime
  idleExpiresAt     DateTime
  absoluteExpiresAt DateTime
  reverifiedAt      DateTime?
  revokedAt         DateTime?

  @@index([userId, revokedAt])
  @@index([idleExpiresAt])
  @@index([absoluteExpiresAt])
}

model Grade {
  id                  String   @id @default(cuid())
  code                String   @unique
  name                String   @unique
  sortOrder           Int      @default(0)
  enabled             Boolean  @default(true)
  gamificationEnabled Boolean  @default(true)
  students            User[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model StudentReviewRecord {
  id              String                @id @default(cuid())
  studentId       String
  student         User                  @relation("StudentReviewStudent", fields: [studentId], references: [id], onDelete: Cascade)
  action          StudentReviewAction
  actorUserId     String
  actor           User                  @relation("StudentReviewActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  beforeStatus    StudentAccountStatus?
  afterStatus     StudentAccountStatus?
  rejectionReason String?               @db.Text
  profileSnapshot Json
  createdAt       DateTime              @default(now())

  @@index([studentId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model Level {
  id             String                  @id @default(cuid())
  code           String                  @unique
  name           String
  sortOrder      Int                     @default(0)
  enabled        Boolean                 @default(true)
  questions      QuestionLevel[]
  practiceRule   LevelPracticeRule?
  examRule       ExamRule?
  knowledgeRules KnowledgePracticeRule[]
  sessions       PracticeSession[]
  students       User[]                  @relation("StudentActiveLevel")
  studentLevelQuestionStates StudentLevelQuestionState[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([enabled, sortOrder])
}

model KnowledgePointType {
  id        String              @id @default(cuid())
  code      String              @unique
  name      String
  sortOrder Int                 @default(0)
  enabled   Boolean             @default(true)
  points    KnowledgePoint[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([enabled, sortOrder])
}

model ExamRule {
  id              String   @id @default(cuid())
  levelId         String   @unique
  level           Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  singleCount     Int
  multipleCount   Int
  durationMinutes Int
  passingCount    Int
  enabled         Boolean  @default(true)
  version         Int      @default(1)
  updatedAt       DateTime @updatedAt
}

model KnowledgePoint {
  id            String                  @id @default(cuid())
  typeId        String
  type          KnowledgePointType      @relation(fields: [typeId], references: [id])
  code          String
  name          String
  path          String
  depth         Int
  sortOrder     Int                     @default(0)
  enabled       Boolean                 @default(true)
  version       Int                     @default(1)
  parentId      String?
  parent        KnowledgePoint?         @relation("KnowledgeTree", fields: [parentId], references: [id], onDelete: Restrict)
  children      KnowledgePoint[]        @relation("KnowledgeTree")
  questions     Question[]
  practiceRules KnowledgePracticeRule[]
  sessions      PracticeSession[]
  reviewCards   ReviewCard[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@unique([typeId, code])
  @@index([parentId, sortOrder])
  @@index([typeId, enabled, depth])
}

model LevelPracticeRule {
  id            String   @id @default(cuid())
  levelId       String   @unique
  level         Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  singleCount   Int      @default(0)
  multipleCount Int      @default(0)
  enabled       Boolean  @default(true)
  version       Int      @default(1)
  updatedAt     DateTime @updatedAt
}

model KnowledgePracticeRule {
  id               String         @id @default(cuid())
  knowledgePointId String
  levelId          String
  knowledgePoint   KnowledgePoint @relation(fields: [knowledgePointId], references: [id], onDelete: Cascade)
  level            Level          @relation(fields: [levelId], references: [id], onDelete: Cascade)
  singleCount      Int            @default(0)
  multipleCount    Int            @default(0)
  enabled          Boolean        @default(true)
  version          Int            @default(1)
  updatedAt        DateTime       @updatedAt

  @@unique([knowledgePointId, levelId])
  @@index([levelId])
}

model Question {
  id                      String                    @id @default(cuid())
  knowledgePointId        String
  knowledgePoint          KnowledgePoint            @relation(fields: [knowledgePointId], references: [id])
  levels                  QuestionLevel[]
  images                  QuestionImage[]
  sourceBankCode          String?
  externalQuestionCode    String?                   @unique
  stem                    String                    @db.Text
  type                    QuestionType
  optionCount             Int
  correctOptionCount      Int
  selectionSpec           String
  preserveOptionOrder     Boolean                   @default(false)
  options                 Json
  correctOptionIds        Json
  status                  QuestionStatus            @default(ACTIVE)
  version                 Int                       @default(1)
  importBatchId           String?
  importBatch             ImportBatch?              @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  sessionQuestions        PracticeSessionQuestion[]
  answers                 PracticeAnswer[]
  wrongQuestions          WrongQuestion[]
  reviewCards             ReviewCard[]
  studentLevelQuestionStates StudentLevelQuestionState[]
  revisions               QuestionRevision[]
  aiConversations         AiConversation[]
  explanation             String?                   @db.Text
  explanationStatus       String                    @default("NONE")
  explanationVersion      Int                       @default(0)
  explanationRejectReason String?                   @db.Text
  explanationReviewedById String?
  explanationReviewedBy   User?                     @relation("QuestionExplanationReviewedBy", fields: [explanationReviewedById], references: [id], onDelete: SetNull)
  explanationReviewedAt   DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  @@index([type, status])
  @@index([knowledgePointId, type, status])
  @@index([externalQuestionCode])
}

model QuestionLevel {
  id         String   @id @default(cuid())
  questionId String
  levelId    String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  level      Level    @relation(fields: [levelId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())

  @@unique([questionId, levelId])
  @@index([levelId])
}

model QuestionRevision {
  id           String   @id @default(cuid())
  questionId   String
  question     Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  revision     Int
  snapshot     Json
  changeSource String
  actorUserId  String?
  actor        User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@unique([questionId, revision])
  @@index([questionId, createdAt])
  @@index([actorUserId, createdAt])
}

model QuestionImage {
  id          String   @id @default(cuid())
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  field       String   @db.VarChar(32)
  sortOrder   Int      @default(0)
  data        Bytes    @db.LongBlob
  mimeType    String   @db.VarChar(64)
  sizeBytes   Int
  contentHash String   @db.VarChar(64)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([questionId, field, sortOrder])
  @@index([contentHash])
}

model PracticeSession {
  id                      String                    @id @default(cuid())
  userId                  String
  user                    User                      @relation(fields: [userId], references: [id])
  mode                    PracticeMode
  levelId                 String?
  level                   Level?                    @relation(fields: [levelId], references: [id], onDelete: Restrict)
  knowledgePointId        String?
  knowledgePoint          KnowledgePoint?           @relation(fields: [knowledgePointId], references: [id], onDelete: Restrict)
  status                  PracticeStatus            @default(IN_PROGRESS)
  singleCountSnapshot     Int
  multipleCountSnapshot   Int
  currentIndex            Int                       @default(0)
  correctCount            Int                       @default(0)
  durationMinutesSnapshot Int?
  passingCountSnapshot    Int?
  expiresAt               DateTime?
  examSettlementSource    ExamSettlementSource?
  startedAt               DateTime                  @default(now())
  completedAt             DateTime?
  questions               PracticeSessionQuestion[]
  answers                 PracticeAnswer[]
  examDraft               ExamDraft?
  aiConversations         AiConversation[]

  @@index([userId, status, startedAt])
  @@index([mode, status, expiresAt])
}

model FocusSession {
  id                  String             @id @default(cuid())
  userId              String
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status              FocusSessionStatus @default(IN_PROGRESS)
  targetMinutes       Int?
  targetQuestionCount Int?
  actualMinutes       Int?
  actualQuestionCount Int?
  startedAt           DateTime           @default(now())
  endedAt             DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([userId, status, startedAt])
  @@index([userId, endedAt])
}

model PlayerProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  xp                  Int      @default(0)
  level               Int      @default(1)
  title               String   @default("见习报务员")
  gamificationEnabled Boolean  @default(true)
  mapEnabled          Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([level])
}

model PlayerLevel {
  id         String   @id @default(cuid())
  level      Int      @unique
  title      String
  xpRequired Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([xpRequired])
}

model QuestLog {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  questDate   DateTime    @db.Date
  type        QuestType
  target      Int
  progress    Int         @default(0)
  status      QuestStatus @default(IN_PROGRESS)
  xpReward    Int         @default(0)
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([userId, questDate, type])
  @@index([userId, questDate, status])
}

model XpLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Int
  reason     String
  sourceType String?
  sourceId   String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

model ExamDraft {
  id           String          @id @default(cuid())
  sessionId    String          @unique
  session      PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answers      Json
  currentIndex Int             @default(0)
  version      Int             @default(0)
  updatedAt    DateTime        @updatedAt
  createdAt    DateTime        @default(now())

  @@index([updatedAt])
}

model PracticeSessionQuestion {
  id         String          @id @default(cuid())
  sessionId  String
  questionId String
  position   Int
  snapshot   Json
  session    PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question   Question        @relation(fields: [questionId], references: [id])

  @@unique([sessionId, questionId])
  @@unique([sessionId, position])
}

model PracticeAnswer {
  id                        String          @id @default(cuid())
  sessionId                 String
  questionId                String
  session                   PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question                  Question        @relation(fields: [questionId], references: [id])
  selectedOptionIds         Json
  idempotencyKey            String?         @db.VarChar(128)
  isCorrect                 Boolean
  answeredCountAtSubmission Int?
  correctCountAtSubmission  Int?
  submittedAt               DateTime        @default(now())

  @@unique([sessionId, questionId])
  @@unique([sessionId, idempotencyKey])
  @@index([questionId, isCorrect])
}

model WrongQuestion {
  id                   String    @id @default(cuid())
  userId               String
  questionId           String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question             Question  @relation(fields: [questionId], references: [id])
  wrongCount           Int       @default(1)
  lastWrongReason      String?
  correctSessionCount  Int       @default(0)
  lastCountedSessionId String?
  mastered             Boolean   @default(false)
  lastWrongAt          DateTime  @default(now())
  masteredAt           DateTime?

  @@unique([userId, questionId])
  @@index([userId])
  @@index([userId, mastered])
}

model ReviewPlan {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  planDate    DateTime         @db.Date
  type        ReviewPlanType   @default(DAILY)
  status      ReviewPlanStatus @default(ACTIVE)
  examDate    DateTime?        @db.Date
  completedAt DateTime?
  cards       ReviewCard[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([userId, planDate, type])
  @@index([userId, planDate, status])
  @@index([userId, type, status])
}

model ReviewCard {
  id               String           @id @default(cuid())
  reviewPlanId     String
  reviewPlan       ReviewPlan       @relation(fields: [reviewPlanId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question         @relation(fields: [questionId], references: [id], onDelete: Restrict)
  knowledgePointId String?
  knowledgePoint   KnowledgePoint?  @relation(fields: [knowledgePointId], references: [id], onDelete: Restrict)
  source           ReviewCardSource
  priority         Int              @default(0)
  status           ReviewCardStatus @default(PENDING)
  completedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([reviewPlanId, questionId])
  @@index([reviewPlanId, status])
  @@index([questionId, status])
  @@index([knowledgePointId, status])
}

model StudentLevelQuestionState {
  id             String        @id @default(cuid())
  userId         String
  levelId        String
  questionId     String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  level          Level         @relation(fields: [levelId], references: [id], onDelete: Restrict)
  question       Question      @relation(fields: [questionId], references: [id], onDelete: Restrict)
  state          LearningState @default(NEW)
  dueAt          DateTime?
  stability      Float         @default(0)
  difficulty     Float         @default(5)
  reps           Int           @default(0)
  lapses         Int           @default(0)
  intervalDays   Int           @default(0)
  lastReviewedAt DateTime?
  favorite       Boolean       @default(false)
  ignored        Boolean       @default(false)
  wrongCount     Int           @default(0)
  correctCount   Int           @default(0)
  lastResult     AnswerResult?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([userId, levelId, questionId])
  @@index([userId, levelId, state, dueAt])
  @@index([userId, levelId, favorite])
  @@index([userId, levelId, ignored])
  @@index([questionId])
  @@index([levelId])
}

model ImportBatch {
  id            String             @id @default(cuid())
  fileName      String
  status        ImportStatus       @default(PREVIEW)
  totalRows     Int                @default(0)
  validRows     Int                @default(0)
  warningRows   Int                @default(0)
  errorRows     Int                @default(0)
  insertedRows  Int                @default(0)
  duplicateRows Int                @default(0)
  errorReport   Json?
  importedById  String
  importedBy    User               @relation(fields: [importedById], references: [id])
  questions     Question[]
  rows          ImportBatchRow[]
  images        ImportBatchImage[]
  createdAt     DateTime           @default(now())
  expiresAt     DateTime?
  committedAt   DateTime?
  revertedAt    DateTime?

  @@index([importedById, status, createdAt])
  @@index([status, expiresAt])
}

model ImportBatchRow {
  id        String      @id @default(cuid())
  batchId   String
  batch     ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber Int
  payload   Json
  issues    Json
  valid     Boolean
  createdAt DateTime    @default(now())

  @@unique([batchId, rowNumber])
  @@index([batchId, valid, rowNumber])
}

model ImportBatchImage {
  id          String      @id
  batchId     String
  batch       ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber   Int
  field       String      @db.VarChar(32)
  sortOrder   Int         @default(0)
  data        Bytes       @db.LongBlob
  mimeType    String      @db.VarChar(64)
  sizeBytes   Int
  contentHash String      @db.VarChar(64)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([batchId, id])
  @@index([batchId, rowNumber, field, sortOrder])
}

model StudentImportBatch {
  id          String              @id @default(cuid())
  fileName    String
  status      StudentImportStatus @default(PREVIEW)
  totalRows   Int                 @default(0)
  validRows   Int                 @default(0)
  errorRows   Int                 @default(0)
  sheetNames  Json
  createdById String
  createdBy   User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  expiresAt   DateTime
  committedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  rows        StudentImportRow[]

  @@index([createdById, status, createdAt])
  @@index([status, expiresAt])
}

model StudentImportRow {
  id                  String             @id @default(cuid())
  batchId             String
  batch               StudentImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  sheetName           String
  sourceRowNumber     Int
  payload             Json
  initialPasswordHash String?            @db.Text
  issues              Json
  valid               Boolean
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([batchId, sheetName, sourceRowNumber])
  @@index([batchId, valid, sheetName, sourceRowNumber])
}

model LoginAttempt {
  id           String   @id @default(cuid())
  usernameHash String
  ipHash       String
  success      Boolean
  createdAt    DateTime @default(now())

  @@index([usernameHash, success, createdAt])
  @@index([ipHash, success, createdAt])
}

model AiUsageLog {
  id               String   @id @default(cuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action           String
  provider         String
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  latencyMs        Int?
  requestHash      String?
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model AiConversation {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId        String
  question          Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  practiceSessionId String?
  practiceSession   PracticeSession? @relation(fields: [practiceSessionId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  messages          AiMessage[]

  @@index([userId, updatedAt])
  @@index([questionId, updatedAt])
  @@index([practiceSessionId, updatedAt])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String         @db.Text
  feedback       String?
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

model SensitiveDataReauthenticationAttempt {
  id        String   @id @default(cuid())
  userId    String
  ipHash    String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([userId, success, createdAt], map: "SensitiveDataReauth_user_success_createdAt_idx")
  @@index([ipHash, success, createdAt], map: "SensitiveDataReauth_ip_success_createdAt_idx")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}
