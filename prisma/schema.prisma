generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum StudentAccountStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum StudentRegistrationSource {
  SELF_REGISTRATION
  EXCEL_IMPORT
  LEGACY
}

enum StudentGender {
  MALE
  FEMALE
}

enum StudentReviewAction {
  SUBMITTED
  PROFILE_UPDATED
  RESUBMITTED
  APPROVED
  REJECTED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

enum QuestionStatus {
  ACTIVE
  DISABLED
  ARCHIVED
}

enum PracticeMode {
  LEVEL_COMPREHENSIVE
  KNOWLEDGE_POINT
  WRONG_QUESTION
  QUESTION_ORDER
  RANDOM_ALL
  MOCK_EXAM
}

enum PracticeStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum ImportStatus {
  PREVIEW
  COMMITTED
  REVERTED
  FAILED
}

enum StudentImportStatus {
  PREVIEW
  COMMITTED
  FAILED
  EXPIRED
}

model User {
  id                    String                     @id @default(cuid())
  username              String                     @unique
  displayName           String
  passwordHash          String
  role                  UserRole                   @default(STUDENT)
  enabled               Boolean                    @default(true)
  mustChangePassword    Boolean                    @default(true)
  sessionVersion        Int                        @default(0)
  studentStatus         StudentAccountStatus?
  registrationSource    StudentRegistrationSource?
  nationalIdEncrypted   String?                    @db.Text
  nationalIdHash        String?                    @unique
  nationalIdLast4       String?                    @db.VarChar(4)
  gender                StudentGender?
  school                String?
  gradeId               String?
  grade                 Grade?                     @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  phoneEncrypted        String?                    @db.Text
  phoneHash             String?                    @unique
  phoneLast4            String?                    @db.VarChar(4)
  submittedAt           DateTime?
  reviewedAt            DateTime?
  reviewedById          String?
  reviewedBy            User?                      @relation("StudentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedStudents      User[]                     @relation("StudentReviewedBy")
  rejectionReason       String?                    @db.Text
  validFrom             DateTime?                  @db.Date
  validUntil            DateTime?                  @db.Date
  isLongTerm            Boolean                    @default(false)
  profileIncomplete     Boolean                    @default(false)
  sessions              PracticeSession[]
  wrongQuestions        WrongQuestion[]
  imports               ImportBatch[]
  studentImports        StudentImportBatch[]
  auditLogs             AuditLog[]
  studentReviewRecords  StudentReviewRecord[]      @relation("StudentReviewStudent")
  authoredReviewRecords StudentReviewRecord[]      @relation("StudentReviewActor")
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  @@index([role, studentStatus, enabled])
  @@index([gradeId, studentStatus])
  @@index([reviewedById, reviewedAt])
}

model Grade {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String   @unique
  sortOrder Int      @default(0)
  enabled   Boolean  @default(true)
  students  User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentReviewRecord {
  id              String                @id @default(cuid())
  studentId       String
  student         User                  @relation("StudentReviewStudent", fields: [studentId], references: [id], onDelete: Cascade)
  action          StudentReviewAction
  actorUserId     String
  actor           User                  @relation("StudentReviewActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  beforeStatus    StudentAccountStatus?
  afterStatus     StudentAccountStatus?
  rejectionReason String?               @db.Text
  profileSnapshot Json
  createdAt       DateTime              @default(now())

  @@index([studentId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model Course {
  id                       String                    @id @default(cuid())
  code                     String                    @unique
  name                     String
  sortOrder                Int                       @default(0)
  enabled                  Boolean                   @default(false)
  activeSlot               Int?                      @unique
  boundaryId               Int?                      @unique
  boundaryAnchor           CourseBoundary?           @relation("CourseBoundaryAnchor", fields: [boundaryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  levels                   Level[]
  examRules                ExamRule[]
  knowledgePoints          KnowledgePoint[]
  levelPracticeRules       LevelPracticeRule[]
  knowledgePracticeRules   KnowledgePracticeRule[]
  questions                Question[]
  importBatches            ImportBatch[]
  practiceSessions         PracticeSession[]
  practiceSessionQuestions PracticeSessionQuestion[]
  practiceAnswers          PracticeAnswer[]
  wrongQuestions           WrongQuestion[]
  boundaryRecord           CourseBoundary?           @relation("CourseBoundaryCourse")
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@index([enabled, sortOrder])
}

model CourseBoundary {
  id             Int     @id
  courseId       String  @unique
  course         Course  @relation("CourseBoundaryCourse", fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  anchoredCourse Course? @relation("CourseBoundaryAnchor")
}

model Level {
  id             String                  @id @default(cuid())
  courseId       String                  @default("course-radio")
  course         Course                  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  code           String
  name           String
  sortOrder      Int                     @default(0)
  enabled        Boolean                 @default(true)
  questions      Question[]
  practiceRule   LevelPracticeRule?
  examRule       ExamRule?
  knowledgeRules KnowledgePracticeRule[]
  sessions       PracticeSession[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([courseId, code])
  @@unique([courseId, id])
  @@index([courseId, enabled, sortOrder])
}

model ExamRule {
  id              String   @id @default(cuid())
  courseId        String   @default("course-radio")
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  levelId         String
  level           Level    @relation(fields: [courseId, levelId], references: [courseId, id], onDelete: Cascade)
  singleCount     Int
  multipleCount   Int
  durationMinutes Int
  passingCount    Int
  enabled         Boolean  @default(true)
  updatedAt       DateTime @updatedAt

  @@unique([courseId, levelId])
}

model KnowledgePoint {
  id            String                  @id @default(cuid())
  courseId      String                  @default("course-radio")
  course        Course                  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  code          String
  name          String
  path          String
  depth         Int
  sortOrder     Int                     @default(0)
  enabled       Boolean                 @default(true)
  parentId      String?
  parent        KnowledgePoint?         @relation("KnowledgeTree", fields: [courseId, parentId], references: [courseId, id], onDelete: Restrict)
  children      KnowledgePoint[]        @relation("KnowledgeTree")
  questions     Question[]
  practiceRules KnowledgePracticeRule[]
  sessions      PracticeSession[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@unique([courseId, code])
  @@unique([courseId, path])
  @@unique([courseId, id])
  @@index([courseId, parentId, sortOrder])
}

model LevelPracticeRule {
  id            String   @id @default(cuid())
  courseId      String   @default("course-radio")
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  levelId       String
  level         Level    @relation(fields: [courseId, levelId], references: [courseId, id], onDelete: Cascade)
  singleCount   Int      @default(0)
  multipleCount Int      @default(0)
  enabled       Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  @@unique([courseId, levelId])
}

model KnowledgePracticeRule {
  id               String         @id @default(cuid())
  courseId         String         @default("course-radio")
  course           Course         @relation(fields: [courseId], references: [id], onDelete: Restrict)
  knowledgePointId String
  levelId          String
  knowledgePoint   KnowledgePoint @relation(fields: [courseId, knowledgePointId], references: [courseId, id], onDelete: Cascade)
  level            Level          @relation(fields: [courseId, levelId], references: [courseId, id], onDelete: Cascade)
  singleCount      Int            @default(0)
  multipleCount    Int            @default(0)
  enabled          Boolean        @default(true)
  updatedAt        DateTime       @updatedAt

  @@unique([courseId, knowledgePointId, levelId])
  @@index([courseId, levelId])
}

model Question {
  id                   String                    @id @default(cuid())
  courseId             String                    @default("course-radio")
  course               Course                    @relation(fields: [courseId], references: [id], onDelete: Restrict)
  levelId              String
  knowledgePointId     String
  level                Level                     @relation(fields: [courseId, levelId], references: [courseId, id])
  knowledgePoint       KnowledgePoint            @relation(fields: [courseId, knowledgePointId], references: [courseId, id])
  sourceBankCode       String?
  externalQuestionCode String?
  stem                 String                    @db.Text
  type                 QuestionType
  optionCount          Int
  correctOptionCount   Int
  selectionSpec        String
  options              Json
  correctOptionIds     Json
  status               QuestionStatus            @default(ACTIVE)
  importBatchId        String?
  importBatch          ImportBatch?              @relation(fields: [courseId, importBatchId], references: [courseId, id], onDelete: Restrict)
  sessionQuestions     PracticeSessionQuestion[]
  answers              PracticeAnswer[]
  wrongQuestions       WrongQuestion[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@unique([courseId, levelId, externalQuestionCode])
  @@unique([courseId, id])
  @@index([courseId, levelId, type, status])
  @@index([courseId, knowledgePointId, levelId, type, status])
  @@index([courseId, externalQuestionCode])
}

model PracticeSession {
  id                      String                    @id @default(cuid())
  courseId                String                    @default("course-radio")
  course                  Course                    @relation(fields: [courseId], references: [id], onDelete: Restrict)
  userId                  String
  user                    User                      @relation(fields: [userId], references: [id])
  mode                    PracticeMode
  levelId                 String?
  level                   Level?                    @relation(fields: [courseId, levelId], references: [courseId, id], onDelete: Restrict)
  knowledgePointId        String?
  knowledgePoint          KnowledgePoint?           @relation(fields: [courseId, knowledgePointId], references: [courseId, id], onDelete: Restrict)
  status                  PracticeStatus            @default(IN_PROGRESS)
  singleCountSnapshot     Int
  multipleCountSnapshot   Int
  currentIndex            Int                       @default(0)
  correctCount            Int                       @default(0)
  durationMinutesSnapshot Int?
  passingCountSnapshot    Int?
  expiresAt               DateTime?
  startedAt               DateTime                  @default(now())
  completedAt             DateTime?
  questions               PracticeSessionQuestion[]
  answers                 PracticeAnswer[]

  @@unique([courseId, id])
  @@index([userId, status, startedAt])
}

model PracticeSessionQuestion {
  id         String          @id @default(cuid())
  courseId   String          @default("course-radio")
  course     Course          @relation(fields: [courseId], references: [id], onDelete: Restrict)
  sessionId  String
  questionId String
  position   Int
  snapshot   Json
  session    PracticeSession @relation(fields: [courseId, sessionId], references: [courseId, id], onDelete: Cascade)
  question   Question        @relation(fields: [courseId, questionId], references: [courseId, id])

  @@unique([courseId, sessionId, questionId])
  @@unique([courseId, sessionId, position])
}

model PracticeAnswer {
  id                String          @id @default(cuid())
  courseId          String          @default("course-radio")
  course            Course          @relation(fields: [courseId], references: [id], onDelete: Restrict)
  sessionId         String
  questionId        String
  session           PracticeSession @relation(fields: [courseId, sessionId], references: [courseId, id], onDelete: Cascade)
  question          Question        @relation(fields: [courseId, questionId], references: [courseId, id])
  selectedOptionIds Json
  isCorrect         Boolean
  submittedAt       DateTime        @default(now())

  @@unique([courseId, sessionId, questionId])
  @@index([courseId, questionId, isCorrect])
}

model WrongQuestion {
  id          String    @id @default(cuid())
  courseId    String    @default("course-radio")
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Restrict)
  userId      String
  questionId  String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question    Question  @relation(fields: [courseId, questionId], references: [courseId, id])
  wrongCount  Int       @default(1)
  mastered    Boolean   @default(false)
  lastWrongAt DateTime  @default(now())
  masteredAt  DateTime?

  @@unique([courseId, userId, questionId])
  @@index([userId])
  @@index([courseId, userId, mastered])
}

model ImportBatch {
  id            String           @id @default(cuid())
  courseId      String           @default("course-radio")
  course        Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  fileName      String
  status        ImportStatus     @default(PREVIEW)
  totalRows     Int              @default(0)
  validRows     Int              @default(0)
  warningRows   Int              @default(0)
  errorRows     Int              @default(0)
  insertedRows  Int              @default(0)
  duplicateRows Int              @default(0)
  errorReport   Json?
  importedById  String
  importedBy    User             @relation(fields: [importedById], references: [id])
  questions     Question[]
  rows          ImportBatchRow[]
  createdAt     DateTime         @default(now())
  expiresAt     DateTime?
  committedAt   DateTime?
  revertedAt    DateTime?

  @@unique([courseId, id])
  @@index([importedById, status, createdAt])
}

model ImportBatchRow {
  id        String      @id @default(cuid())
  batchId   String
  batch     ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber Int
  payload   Json
  issues    Json
  valid     Boolean
  createdAt DateTime    @default(now())

  @@unique([batchId, rowNumber])
  @@index([batchId, valid, rowNumber])
}

model StudentImportBatch {
  id          String              @id @default(cuid())
  fileName    String
  status      StudentImportStatus @default(PREVIEW)
  totalRows   Int                 @default(0)
  validRows   Int                 @default(0)
  errorRows   Int                 @default(0)
  sheetNames  Json
  createdById String
  createdBy   User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  expiresAt   DateTime
  committedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  rows        StudentImportRow[]

  @@index([createdById, status, createdAt])
  @@index([status, expiresAt])
}

model StudentImportRow {
  id                       String             @id @default(cuid())
  batchId                  String
  batch                    StudentImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  sheetName                String
  sourceRowNumber          Int
  payload                  Json
  initialPasswordEncrypted String?            @db.Text
  issues                   Json
  valid                    Boolean
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  @@unique([batchId, sheetName, sourceRowNumber])
  @@index([batchId, valid, sheetName, sourceRowNumber])
}

model LoginAttempt {
  id           String   @id @default(cuid())
  usernameHash String
  ipHash       String
  success      Boolean
  createdAt    DateTime @default(now())

  @@index([usernameHash, success, createdAt])
  @@index([ipHash, success, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}
