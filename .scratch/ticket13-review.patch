+export type ImportDuplicateKind = "EXACT" | "CONFLICT" | "SUSPECT";
+
+type ComparableQuestion = {
+  externalQuestionCode?: string | null;
+  stem: string;
+  options: unknown;
+  correctOptionIds: unknown;
+};
+
 const OPTION_IDS = ["A", "B", "C", "D", "E", "F", "G", "H"];
